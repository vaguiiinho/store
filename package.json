{
  "name": "store",
  "private": true,
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run start:dev --workspace api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace web",
    "build:api": "npm run build --workspace api",
    "db:generate": "npm run prisma:generate --workspace api",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace api",
    "lint": "eslint .",
    "lint:web": "npm run lint --workspace web",
    "lint:api": "npm run lint --workspace api",
    "format": "prettier --write .",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm run test --workspace web",
    "test:api": "npm run test --workspace api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
