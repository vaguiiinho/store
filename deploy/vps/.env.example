# Modelo do .env de producao. Fluxo:
#   cp deploy/vps/.env.example deploy/vps/.env && chmod 600 deploy/vps/.env   (fica so na sua maquina; ignorado pelo Git)
#   npm run deploy:env -- usuario@host [--restart]                           (envia para $VPS_PATH/.env na VPS)
# O CD nunca sobrescreve o .env da VPS; so grava APP_VERSION e DOCKER_HUB_USERNAME nele.
# Valores entre aspas simples sao literais para o docker compose (podem ter $, #, espacos).

# --- Banco (obrigatorio) --------------------------------------------------------------------------
POSTGRES_USER='store'
# Use so letras e numeros: a senha compoe a DATABASE_URL. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=''
POSTGRES_DB='store'

# --- App (obrigatorio) ----------------------------------------------------------------------------
# URL publica da loja (define cookie Secure quando https).
PUBLIC_ORIGIN='https://loja.seudominio.com'
# Gere com: openssl rand -base64 48
AUTH_SECRET=''

# Admin principal: criado/sincronizado a cada subida da API (o .env e a fonte da verdade da senha).
ADMIN_EMAIL=''
ADMIN_PASSWORD=''
ADMIN_NAME='Administrador'

# --- Usuario demo (opcional; deixe vazio para nao criar) -------------------------------------------
DEMO_USER_EMAIL=''
DEMO_USER_PASSWORD=''
DEMO_USER_NAME='Usuario Demo'

# --- Pagamento (opcional; padrao mock) -------------------------------------------------------------
PAYMENT_PROVIDER='mock'
PAYMENT_PROVIDER_KEY=''
PAYMENT_PROVIDER_SECRET=''
PAYMENT_PROVIDER_BASE_URL='https://api.mercadopago.com'
PAYMENT_PROVIDER_WEBHOOK_SECRET=''

# --- Gerenciado pelo CD (nao precisa preencher) ----------------------------------------------------
# DOCKER_HUB_USERNAME=''
# APP_VERSION=''
