{
  "name": "api",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --require ts-node/register --test src/modules/catalog/domain/entities/catalog.entities.spec.ts src/modules/cart/domain/entities/cart.entities.spec.ts src/modules/inventory/domain/entities/stock.entity.spec.ts src/modules/orders/domain/entities/order.entity.spec.ts src/modules/catalog/application/catalog.use-cases.spec.ts src/modules/orders/application/order.use-cases.spec.ts src/modules/payments/application/payment.use-cases.spec.ts",
    "test:integration": "node --require ts-node/register --test test/repositories.integration.spec.ts",
    "db:seed": "node prisma/seed.js",
    "db:reset-demo": "node prisma/reset-demo-data.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
